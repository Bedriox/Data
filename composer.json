{
    "name": "bedriox/data",
    "description": "Versioned Minecraft: Bedrock Edition datasets for Bedriox.",
    "type": "project",
    "license": "GPL-3.0-only",
    "homepage": "https://bedriox.com",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Bedriox\\Data\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bedriox\\Data\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "check": ["@test", "@analyse"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    }
}
